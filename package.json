{
  "name": "ratatouille-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.10.0"
  },
  "scripts": {
    "dev": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web dev",
    "build": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web build",
    "start": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web start",
    "lint": "pnpm --filter @ratatouille/web lint",
    "lint:fix": "pnpm --filter @ratatouille/web lint:fix",
    "typecheck": "pnpm --filter @ratatouille/web typecheck",
    "test": "pnpm --filter @ratatouille/web test",
    "test:unit": "pnpm --filter @ratatouille/web test:unit",
    "test:watch": "pnpm --filter @ratatouille/web test:watch",
    "test:coverage": "pnpm --filter @ratatouille/web test:coverage",
    "test:e2e": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web test:e2e",
    "test:e2e:ui": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web test:e2e:ui",
    "db:generate": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web db:generate",
    "db:migrate": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web db:migrate",
    "db:push": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web db:push",
    "db:studio": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web db:studio",
    "db:seed": "node infra/scripts/with-env.mjs pnpm --filter @ratatouille/web db:seed",
    "infra:up": "node infra/scripts/compose.mjs up",
    "infra:db": "node infra/scripts/compose.mjs db",
    "infra:down": "node infra/scripts/compose.mjs down",
    "infra:down:volumes": "node infra/scripts/compose.mjs down:volumes",
    "infra:ps": "node infra/scripts/compose.mjs ps",
    "infra:logs": "node infra/scripts/compose.mjs logs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @ratatouille/web exec eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
