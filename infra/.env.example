# Shared defaults for Compose and local root commands.
POSTGRES_USER=ratatouille
POSTGRES_PASSWORD=ratatouille
POSTGRES_DB=ratatouille_ai
POSTGRES_PORT=5432
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=8000

# Django. An empty secret generates a key stored in the API volume.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1"
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
